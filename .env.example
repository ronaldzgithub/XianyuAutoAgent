API_KEY=默认使用通义千问,apikey通过百炼模型平台获取
COOKIES_STR=your_cookies_here
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
# desired-state 命令：重复消息不会反向切换状态。
MANUAL_TAKEOVER_KEYWORDS=。
MANUAL_RESUME_KEYWORDS=恢复自动
SIMULATE_HUMAN_TYPING=False
# 安全默认关闭。只有显式设为 true/1/yes/on 才允许 AI 生成后直接发送。
ENABLE_AI_AUTO_SEND=False
# Huaxiaobao 分配的不透明账号引用；未设置时仅在工具边界内从原生账号生成不可逆引用。
XIANYU_ACCOUNT_REF=
# 原生咨询、幂等结果和人工接管状态共用的 SQLite 权威存储。
XIANYU_ADAPTER_STATE_PATH=data/huaxiaobao_adapter.db
# listener 崩溃后由新实例等待 lease 到期再安全重领，范围 1-3600 秒。
XIANYU_INQUIRY_LEASE_SECONDS=60
